{
  "expo": {
    "name": "MediOS AI Reception",
    "slug": "hospital-nfc-app",
    "scheme": "medios-reception",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medios.reception"
    },
    "android": {
      "package": "com.medios.reception",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1E6BFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-screen-orientation",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow the reception kiosk to read patient NFC cards",
          "includeNdefEntitlement": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./modules/medios-printer/app.plugin.js",
      "./plugins/withKeyboardHiddenOnFocus.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E6BFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
