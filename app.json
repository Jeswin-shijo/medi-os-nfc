{
  "expo": {
    "name": "MediOS AI Reception",
    "slug": "hospital-nfc-app",
    "scheme": "medios-reception",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medios.reception"
    },
    "android": {
      "package": "com.medios.reception",
      "adaptiveIcon": {
        "backgroundColor": "#1E6BFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-screen-orientation",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Allow the reception kiosk to read patient NFC cards",
          "includeNdefEntitlement": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "./modules/medios-printer/app.plugin.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ]
  }
}
